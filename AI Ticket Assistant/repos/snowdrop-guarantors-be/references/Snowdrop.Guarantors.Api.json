{
  "openapi": "3.1.1",
  "info": {
    "title": "Snowdrop Guarantors API",
    "description": "Snowdrop Guarantors API",
    "version": "v1"
  },
  "paths": {
    "/guarantors/patient/{patientId}": {
      "get": {
        "tags": [
          "PatientGuarantors"
        ],
        "summary": "Retrieves all guarantors for a specific patient",
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "description": "Unique identifier for the patient",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "org-id",
            "in": "header",
            "description": "Organization Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of guarantors associated with the patient, including their current status",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PatientGuarantorResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PatientGuarantorResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PatientGuarantorResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "PatientGuarantors"
        ],
        "summary": "Create a new guarantor for a specific patient",
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "description": "Unique identifier for the patient",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "org-id",
            "in": "header",
            "description": "Organization Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Guarantor details including demographic and contact information",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGuarantorRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGuarantorRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateGuarantorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The created guarantor's ID and Financial Account Number (FAN) on success, or Conflict status if the write operation fails",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/CreateGuarantorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateGuarantorResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateGuarantorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "PatientGuarantors"
        ],
        "summary": "Update a guarantor for a specific patient",
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "org-id",
            "in": "header",
            "description": "Organization Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Updated guarantor details including the guarantor ID and modified information",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGuarantorRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGuarantorRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateGuarantorRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "A task representing the asynchronous operation"
          }
        }
      }
    },
    "/guarantors/patient/{patientId}/delete/{guarantorId}": {
      "delete": {
        "tags": [
          "PatientGuarantors"
        ],
        "summary": "Delete a guarantor for a specific patient",
        "parameters": [
          {
            "name": "patientId",
            "in": "path",
            "description": "Unique identifier for the patient",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "guarantorId",
            "in": "path",
            "description": "Unique identifier for the guarantor to be deleted",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "org-id",
            "in": "header",
            "description": "Organization Id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ok status on successful deletion, or Conflict status if the guarantor is assigned to a payer portfolio"
          }
        }
      }
    }
  },
