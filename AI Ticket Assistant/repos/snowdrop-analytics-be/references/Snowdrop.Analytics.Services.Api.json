  "components": {
    "schemas": {
      "DataDictionaryColumn": {
        "required": [
          "tableName",
          "name",
          "order",
          "dataType",
          "description",
          "relatedTable"
        ],
        "type": "object",
        "properties": {
          "tableName": {
            "type": [
              "null",
              "string"
            ]
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "order": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "dataType": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "relatedTable": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DataDictionaryResponseOfDataDictionaryColumn": {
        "type": "object",
        "properties": {
          "published": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "items": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/DataDictionaryColumn"
            }
          }
        }
      },
      "DataDictionaryResponseOfDataDictionaryTable": {
        "type": "object",
        "properties": {
          "published": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "items": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/DataDictionaryTable"
            }
          }
        }
      },
      "DataDictionaryTable": {
        "required": [
          "tableName",
          "description"
        ],
        "type": "object",
        "properties": {
          "tableName": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "EventCategoryEtlStatus": {
        "required": [
          "eventCategory",
          "last5Minutes",
          "last60Minutes",
          "last12Hours"
        ],
        "type": "object",
        "properties": {
          "eventCategory": {
            "type": [
              "null",
              "string"
            ]
          },
          "last5Minutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "last60Minutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "last12Hours": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "EventEtlStatusResponse": {
        "required": [
          "categories",
          "unprocessedEvents"
        ],
        "type": "object",
        "properties": {
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventCategoryEtlStatus"
            }
          },
          "unprocessedEvents": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "PostReportRequest": {
        "required": [
          "fileName",
          "displayName",
          "description",
          "base64Content"
        ],
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "base64Content": {
            "type": "string",
            "format": "byte"
          },
          "content": {
            "type": [
              "null",
              "string"
            ],
            "format": "byte"
          }
        }
      },
      "PowerBiLinksResponse": {
        "required": [
          "customerLink",
          "vendorLink"
        ],
        "type": "object",
        "properties": {
          "customerLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "vendorLink": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "Report": {
        "required": [
          "id",
          "displayName",
          "lastUpdated",
          "description"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "lastUpdated": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "DataDictionary"
    },
    {
      "name": "EtlStatus"
    },
    {
      "name": "PowerBiLinks"
    },
    {
      "name": "Reports"
    }
  ]
}