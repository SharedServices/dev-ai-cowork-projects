{
  "openapi": "3.1.1",
  "info": {
    "title": "Snowdrop Payments Reporting API",
    "description": "Snowdrop Payments Reporting API"
  },
  "servers": [
    {
      "url": "https://api.unlimitedfinancials.ninja/snowdrop/payments-reporting"
    }
  ],
  "paths": {
    "/reporting/paymentremittancereconciliation": {
      "get": {
        "tags": [
          "PaymentRemittanceReconciliation"
        ],
        "summary": "Gets payments for remittance reconciliation",
        "parameters": [
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "RemittanceReconciliationResponse",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RemittanceReconciliationResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemittanceReconciliationResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemittanceReconciliationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reporting/paymentremittancereconciliation/download": {
      "get": {
        "tags": [
          "PaymentRemittanceReconciliation"
        ],
        "summary": "Downloads an Excel spreadsheet of payments",
        "parameters": [
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        }
      }
    },
    "/reporting": {
      "get": {
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "entity",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Report"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Report"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Report"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reporting/{reportId}/history/{runId}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "runId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadReportRunResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadReportRunResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/DownloadReportRunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/reporting/{reportId}/history/list/{groupBy}": {
      "get": {
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "groupBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "continuationToken",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ReportHistoryPage"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportHistoryPage"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportHistoryPage"
                }
              }
            }
          }
        }
      }
    },
    "/reporting/generate/{reportId}": {
      "post": {
        "tags": [
          "Reports"
        ],
        "parameters": [
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "user-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "reportId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/ReportOptionsRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportOptionsRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportOptionsRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ReportOptionsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateResponse"
                }
              }
            }
          }
        }
      }
    }
