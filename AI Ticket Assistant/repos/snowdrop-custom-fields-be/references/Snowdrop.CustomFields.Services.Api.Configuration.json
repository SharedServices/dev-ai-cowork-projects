  "components": {
    "schemas": {
      "CreateFieldRequest": {
        "required": [
          "labelName",
          "enabled",
          "size",
          "options"
        ],
        "type": "object",
        "properties": {
          "labelName": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "size": {
            "$ref": "#/components/schemas/FieldSize"
          },
          "options": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IFieldTypeOptions"
              }
            ]
          }
        }
      },
      "FieldResponse": {
        "required": [
          "id",
          "systemId",
          "sectionId",
          "labelName",
          "enabled",
          "size",
          "options"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "systemId": {
            "type": "string",
            "format": "uuid"
          },
          "sectionId": {
            "type": "string",
            "format": "uuid"
          },
          "labelName": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "size": {
            "$ref": "#/components/schemas/FieldSize"
          },
          "options": {
