{
  "openapi": "3.1.1",
  "info": {
    "title": "Phoenix Public API",
    "description": "Phoenix Public API"
  },
  "servers": [
    {
      "url": "https://api.unlimitedfinancials.ninja/phoenix/public"
    }
  ],
  "paths": {
    "/channels/inbound": {
      "get": {
        "tags": [
          "ChannelsInbound"
        ],
        "summary": "Get a list of all inbound channels grouped by system",
        "parameters": [
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSystemsListResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSystemsListResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicSystemsListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChannelListItem": {
        "required": [
          "id",
          "name"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "PublicSystemsListResponse": {
        "required": [
          "systems"
        ],
        "type": "object",
        "properties": {
          "systems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicSystemsListResponseItem"
            }
          }
        }
      },
      "PublicSystemsListResponseItem": {
        "required": [
          "id",
          "systemTypeId",
          "name",
          "channels"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "systemTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "channels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChannelListItem"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "ChannelsInbound"
    }
  ]
}