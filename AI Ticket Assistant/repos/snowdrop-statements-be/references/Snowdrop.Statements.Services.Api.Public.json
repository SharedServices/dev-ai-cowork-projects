  "components": {
    "schemas": {
      "Bill": {
        "required": [
          "billId",
          "createdDate",
          "dateOfService",
          "age",
          "billNumber",
          "chargedAmount",
          "adjustedAmount",
          "paidAmount",
          "balanceAmount",
          "charges"
        ],
        "type": "object",
        "properties": {
          "billId": {
            "type": "string",
            "format": "uuid"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "dateOfService": {
            "$ref": "#/components/schemas/Date"
          },
          "age": {
            "$ref": "#/components/schemas/BillAge"
          },
          "billNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "chargedAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "adjustedAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "paidAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "balanceAmount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "charges": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Charge"
            }
          }
        }
      },
      "BillAge": {
        "type": "integer"
      },
      "BrandStatementBatchRecord": {
        "required": [
          "statementBatchId",
          "runDate",
          "batchType",
          "runType",
          "batchDescription",
          "statementCount",
          "isSampleRun",
          "status"
        ],
        "type": "object",
        "properties": {
          "statementBatchId": {
            "type": "string",
            "format": "uuid"
          },
          "runDate": {
            "type": "string",
            "format": "date-time"
          },
          "batchType": {
            "$ref": "#/components/schemas/StatementBatchType"
          },
          "runType": {
            "$ref": "#/components/schemas/StatementRunType"
          },
          "batchDescription": {
            "type": [
              "null",
              "string"
            ]
          },
          "statementCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "isSampleRun": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/StatementBatchStatus"
          }
        }
      },
      "Charge": {
        "required": [
          "chargeId",
          "chargeCode",
          "chargeDate",
          "activityId",
          "amount",
          "insurancePayments",
          "guarantorPayments",
          "insuranceAdjustments",
          "guarantorAdjustments"
        ],
        "type": "object",
        "properties": {
          "chargeId": {
            "type": "string",
            "format": "uuid"
          },
          "chargeCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "chargeDate": {
            "type": "string",
            "format": "date-time"
          },
          "activityId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "insurancePayments": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
