{
  "openapi": "3.1.1",
  "info": {
    "title": "Snowdrop Ledger Internal API",
    "description": "Snowdrop Ledger Internal API"
  },
  "servers": [
    {
      "url": ""
    }
  ],
  "paths": {
    "/charges/{chargeId}/remittances/{remittanceId}": {
      "get": {
        "tags": [
          "Charges"
        ],
        "parameters": [
          {
            "name": "chargeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "remittanceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "disputeTransactionNumber",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ChargeRemittanceDetail"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChargeRemittanceDetail"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChargeRemittanceDetail"
                }
              }
            }
          }
        }
      }
    },
    "/payers/{payerId}/contracts/{contractId}/allowed": {
      "post": {
        "tags": [
          "Payers"
        ],
        "parameters": [
          {
            "name": "payerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "contractId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/PayerContractAllowedRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PayerContractAllowedRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/PayerContractAllowedRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/PayerContractAllowedRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityDetailAllowed"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityDetailAllowed"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ActivityDetailAllowed"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/remittances/validate": {
      "post": {
        "tags": [
          "Remittances"
        ],
        "parameters": [
          {
            "name": "org-id-req",
            "in": "header",
            "description": "Organization Id Request",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/RemittanceClaimPaymentPosted"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemittanceClaimPaymentPosted"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RemittanceClaimPaymentPosted"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RemittanceClaimPaymentPosted"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RemitValidationResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemitValidationResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemitValidationResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
