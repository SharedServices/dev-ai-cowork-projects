        "type": "object",
        "properties": {
          "chargeCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "modifierId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "ndc": {
            "type": [
              "null",
              "string"
            ]
          },
          "activityCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "dateOfService": {
            "$ref": "#/components/schemas/Date"
          }
        }
      },
      "ActivityDetailAllowed": {
        "required": [
          "activityDetail",
          "successful",
          "allowed"
        ],
        "type": "object",
        "properties": {
          "activityDetail": {
            "$ref": "#/components/schemas/ActivityDetail"
          },
          "successful": {
            "type": "boolean"
          },
          "allowed": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "ChargeRemittanceDetail": {
        "required": [
          "remittanceId",
          "claimId",
          "claimPaymentId",
          "chargePaymentId",
          "checkDate",
          "checkNumber",
          "depositDate",
          "icn",
          "isCrossover",
          "sourceEventNumber"
        ],
        "type": "object",
        "properties": {
          "remittanceId": {
            "type": "string",
            "format": "uuid"
          },
          "claimId": {
            "type": "string",
            "format": "uuid"
          },
          "claimPaymentId": {
            "type": "string",
            "format": "uuid"
          },
          "chargePaymentId": {
            "type": "string",
            "format": "uuid"
          },
          "checkDate": {
            "$ref": "#/components/schemas/Date"
          },
          "checkNumber": {
            "type": [
              "null",
              "string"
            ]
          },
          "depositDate": {
            "$ref": "#/components/schemas/Date"
          },
          "icn": {
            "type": [
              "null",
              "string"
            ]
          },
          "isCrossover": {
            "type": "boolean"
          },
          "sourceEventNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "Date": { },
      "Exception": {
        "type": "object",
        "properties": {
          "targetSite": {
            "$ref": "#/components/schemas/MethodBase"
          },
          "message": {
            "type": [
              "null",
              "string"
            ]
          },
          "data": {
            "type": [
              "null",
              "object"
            ]
          },
          "innerException": {
            "$ref": "#/components/schemas/Exception"
          },
          "helpLink": {
            "type": [
              "null",
              "string"
            ]
          },
          "source": {
            "type": [
              "null",
              "string"
            ]
          },
          "hResult": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "stackTrace": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "MethodBase": { },
      "PayerContractAllowedRequest": {
        "required": [
          "activityDetails"
        ],
        "type": "object",
        "properties": {
          "activityDetails": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/ActivityDetail"
            }
          }
        }
      },
      "RemittanceClaimPaymentPosted": {
        "required": [
          "remittanceId"
        ],
        "type": "object",
        "properties": {
          "remittanceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "RemitValidationMessage": {
        "required": [
          "remittanceId",
          "chargeId",
          "message"
        ],
        "type": "object",
        "properties": {
          "remittanceId": {
            "type": "string",
            "format": "uuid"
          },
          "chargeId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "message": {
            "type": "string"
          },
          "exception": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Exception"
              }
            ]
          }
        }
      },
      "RemitValidationResult": {
        "required": [
          "isValid",
          "messages"
        ],
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RemitValidationMessage"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Charges"
    },
    {
      "name": "Payers"
    },
    {
      "name": "Remittances"
